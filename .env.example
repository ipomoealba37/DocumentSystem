# ============================================================
# 本地密钥模板：复制成 .env 后填写真实值
#   Windows:      copy .env.example .env
#   macOS/Linux:  cp .env.example .env
# .env 已被 .gitignore 排除，永远不会被提交；本模板可以提交。
#
# 生效方式：应用启动时会读取项目根目录的 .env，把键值放进系统属性，
#           application.properties 里的 ${XXX:默认值} 就能取到。
# 优先级：系统环境变量 > .env > application.properties 里的默认值
# 也就是说，IDEA 里配了环境变量就轮不到 .env 了。
# ============================================================

# DeepSeek 密钥（对应 application.properties 的 ai.deepseek.api-key）
# 留空则 AI 摘要提示"未配置"，其它功能不受影响
AI_DEEPSEEK_API_KEY=

# 数据库密码（对应 spring.datasource.password）
MYSQL_PASSWORD=123456
