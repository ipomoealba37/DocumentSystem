# ============================================================
# 配置模板：真实的 application.properties 已被 .gitignore 排除，不入库
# 使用方式（首次拉代码 / 换机器）：
#   Windows:      copy src\main\resources\application.properties.example src\main\resources\application.properties
#   macOS/Linux:  cp src/main/resources/application.properties.example src/main/resources/application.properties
# 然后按下方注释改成本机实际的账号密码
# ============================================================

spring.application.name=documentSystem
server.port=8080

# ---------- 数据库 ----------
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver
spring.datasource.url=jdbc:mysql://localhost:3306/document_system?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&characterEncoding=utf-8
spring.datasource.username=root
# 密码不写死：在 .env 里写 MYSQL_PASSWORD=xxx，或配系统环境变量；都没有则用下面的默认值
spring.datasource.password=${MYSQL_PASSWORD:123456}

# ---------- MyBatis ----------
mybatis.mapper-locations=classpath:mapper/*.xml
mybatis.type-aliases-package=com.javaee.documentsystem.entity
mybatis.configuration.map-underscore-to-camel-case=true
logging.level.com.javaee.documentsystem.mapper=debug

# ---------- 文件上传 ----------
# 单个 HTTP 请求上限：分片上传时一个请求只装一片，保持较小的值即可
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=10MB

# 分片上传配置
# 每片大小（前端按这个值切片，由服务端在 init 时下发）
upload.chunk-size=2MB
# 单文件逻辑上限（不受 multipart 限制）
upload.max-file-size=512MB
# 分片临时目录，留空 = {项目根目录}/chunk-temp
upload.temp-dir=
# 未完成的分片保留几小时，到期由定时任务清理
upload.expire-hours=24

# ---------- Redis ----------
# 本机没起 Redis 时，可用 --spring.cache.type=none 启动
spring.redis.host=localhost
spring.redis.port=6379

# ---------- DeepSeek（AI 摘要） ----------
# 不要把真实 key 写进任何会被提交的文件
# 推荐：IDEA -> Run/Debug Configurations -> Environment variables 加 AI_DEEPSEEK_API_KEY=sk-xxxx
# 留空也能启动：AI 摘要会提示"未配置"，登录/文档/回收站/分片上传都不受影响
ai.deepseek.api-key=${AI_DEEPSEEK_API_KEY:}
ai.deepseek.base-url=https://api.deepseek.com
ai.deepseek.model=deepseek-chat
